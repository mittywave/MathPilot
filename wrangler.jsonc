{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhiti-local-question-bank",
  "account_id": "7a5978bf799135f5848744e55cbeb411",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-05-22",
  "main": "./worker/index.ts",
  "routes": [
    {
      "pattern": "tiku.mittysapce.uk",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "vars": {
    "HOMEWORK_GRADING_ENABLED": "true",
    "HOMEWORK_AUTO_PUBLISH_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zhiti-question-bank",
      "database_id": "8d93b3dc-001f-4f32-adba-4bb5dc971c17",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "HOMEWORK_ASSETS",
      "bucket_name": "zhiti-homework-assets"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "HOMEWORK_GRADING_QUEUE",
        "queue": "zhiti-homework-grading"
      }
    ],
    "consumers": [
      {
        "queue": "zhiti-homework-grading",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 60,
        "dead_letter_queue": "zhiti-homework-grading-dlq"
      }
    ]
  },
  "cache": {
    "enabled": true
  }
}
