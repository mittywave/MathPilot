OPENAI_BASE_URL=https://你的-sub2api-域名
OPENAI_API_KEY=你的_Sub2API_Key
OPENAI_VISION_MODEL=gemini-3.8-flash-high
OPENAI_TEXT_MODEL=gemini-3.8-flash-high
OPENAI_REASONING_EFFORT=high
# 识别以准确抄录为主，独立使用低推理档位可显著缩短照片等待时间
OPENAI_RECOGNITION_REASONING_EFFORT=low
OPENAI_DIAGRAM_REASONING_EFFORT=medium
# auto 会优先使用 Responses，失败时自动尝试 Chat Completions
OPENAI_API_MODE=antigravity_gemini

# 云端注册配置只应通过 Wrangler Secret 设置，不要写入 .env.local 后提交。
# ADMIN_EMAIL=你的管理员邮箱
# REGISTRATION_INVITE_CODE=你发给会员的邀请码

# localhost 一键发布公共资源库。两端的发布密钥必须相同，线上只通过 Wrangler Secret 配置。
# LOCAL_ADMIN_MODE 由 npm run dev 自动注入；绝对不要配置为线上 Cloudflare Secret。
# PUBLIC_LIBRARY_REMOTE_URL=https://tiku.mittysapce.uk
# PUBLIC_LIBRARY_PUBLISH_TOKEN=至少-32-字节随机密钥
# Homework grading is automatically enabled for localhost; set this explicitly
# to true only after production R2/Queue bindings and sample validation are ready.
HOMEWORK_GRADING_ENABLED=false
HOMEWORK_GRADING_MODEL=
GRADING_AUTO_CONFIDENCE=0.90
HOMEWORK_AUTO_PUBLISH_ENABLED=true
# Queue defaults are 30-second exponential retries and 4 total attempts.
# HOMEWORK_QUEUE_RETRY_BASE_SECONDS=30
# HOMEWORK_QUEUE_MAX_ATTEMPTS=4

# Total deadline per recognition attempt, shared by protocol negotiation (ms).
RECOGNITION_TIMEOUT_MS=180000

# AI Provider settings: /settings/ai (administrator only).
# Production: npx wrangler secret put AI_PROVIDER_ENCRYPTION_KEY
# Use a stable, cryptographically random secret of at least 32 bytes. Never commit it.
# Local dev uses an explicitly local-only development key unless overridden.
# AI_PROVIDER_ENCRYPTION_KEY=
AI_REQUEST_TIMEOUT_MS=180000
AI_MODELS_TIMEOUT_MS=15000

# V2 custom providers are configured entirely in /settings/ai:
# enter the public HTTPS Base URL and API Key, then save/test/use it directly.
# No per-provider server allowlist is required.
